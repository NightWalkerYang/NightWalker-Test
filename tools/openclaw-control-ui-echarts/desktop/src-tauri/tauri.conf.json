{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaw",
  "version": "0.1.0",
  "identifier": "ai.openclaw.zero-intrusive-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClaw",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https: wss:; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../runtime": "local-runtime/runtime",
      "../../scripts": "local-runtime/scripts",
      "../../data": "local-runtime/data",
      "../../runtime.env": "local-runtime/runtime.env",
      "../../openclaw.local.example.json5": "local-runtime/openclaw.local.example.json5"
    }
  }
}
