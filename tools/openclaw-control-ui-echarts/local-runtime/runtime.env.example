# 复制为 runtime.env 后再启动。
# 控制台自动连接会在启动时根据这里的 token 同步到 Control UI。
OPENCLAW_GATEWAY_TOKEN=local-runtime-shared-token

# 启动前 Control UI 预检（manifest + 注入点 + 关键产物 smoke）。
# 默认启用；如需临时跳过可设为 1/true（不建议常态使用）。
# OPENCLAW_SKIP_CONTROL_UI_PREFLIGHT=0

# 本地运行包默认把数据放到交付包目录下。
OPENCLAW_CONFIG_DIR=./data/.openclaw
OPENCLAW_CONFIG_PATH=./data/.openclaw/openclaw.json
OPENCLAW_WORKSPACE_DIR=./data/workspace

# 网关端口。
# 本地运行包默认只监听本机回环地址，开箱即可访问；
# 如果客户需要局域网访问，再改成 lan 并额外配置 Control UI origin 放行。
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_PORT=18789

# 按需填写客户自己的模型凭证。
# 下面几项只需要保留会实际使用的那一类。
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# VOLCENGINE_API_KEY=
# ANTHROPIC_API_KEY=

# 租户 sidecar 固定走本地授权版。
OPENCLAW_TENANT_PLATFORM_EDITION=local
OPENCLAW_TENANT_PLATFORM_BIND=0.0.0.0
OPENCLAW_TENANT_PLATFORM_PORT=18801
OPENCLAW_TENANT_PLATFORM_API_BASE=/tenant-platform-api/v1

# 本地授权文件与公钥。
OPENCLAW_TENANT_PLATFORM_LICENSE_PATH=./data/.openclaw/tenant-platform/local-license.json
OPENCLAW_TENANT_PLATFORM_LICENSE_PUBLIC_KEY_PATH=./data/.openclaw/tenant-platform/license-public.pem

# 如需直接写入公钥，也可以用这一项覆盖文件路径。
# OPENCLAW_TENANT_PLATFORM_LICENSE_PUBLIC_KEY=
